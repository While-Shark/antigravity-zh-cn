    },
    {
      "match": "(\\d+)\\s+skills?\\s+enabled",
      "replace": "已启用 $1 项技能"
    },
    {
      "match": "(\\d+)\\s+rules?\\s+active",
      "replace": "$1 条规则处于活动状态"
    }
  ]
}